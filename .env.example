# 서버 접속 포트 (개발 `npm run dev`, exe 옆 `.env`, `npm run preview` 공통)
PORT=3007

# 바인딩 주소 (0.0.0.0 = 외부·LAN 접속 허용, exe 기본 localhost)
# HOSTNAME=0.0.0.0
# LAN 사용 시 exe 폴더에서 allow-firewall-inbound.bat (관리자) 실행으로 방화벽 인바운드 허용

# Vite dev 전용 — 허용 Host (쉼표 구분, * = 모두 허용). exe 빌드에는 포함되지 않음.
# ALLOWED_HOSTS=*

# WebRTC 시그널링 WebSocket 경로 (앱 PORT와 동일 — 별도 포트 불필요)
# VITE_SIGNALING_PATH=/webrtc-signaling

# 공용 y-webrtc 시그널링만 사용 (기본: 자체 /webrtc-signaling)
# VITE_USE_PUBLIC_SIGNALING=true

# 빌드 시점 설정 — exe 실행 시 변경 불가. 홈 버튼 URL (주석 처리 시 앱 첫 화면)
# VITE_HOME_URL=https://example.com

# 총괄관리자 (기본: admin / admin1234)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin1234

# 부서관리자 — 미설정 시 admin.{부서코드} / admin.{부서코드}!! (예: admin.0000001 / admin.0000001!!)
# DEPT_ADMIN_USERNAMEsubadmin
# DEPT_ADMIN_PASSWORD=subadmin!!
# DEPT_ADMIN_BY_DEPT=0000001

# 일반 사용자 공용 비밀번호 (관리자 로그인·레거시, 기본: user!!)
# 앱 접속 시 사용자 이름+부서만으로 자동 참여(/auth/join) — 목록 보기·협업 편집 가능, 생성 불가
# USER_PASSWORD=user!!

# 세션 서명 (선택, 미설정 시 ADMIN_PASSWORD 사용)
# AUTH_SECRET=replace-with-random-string

# ---- Keycloak SSO (Portable Keycloak / Team Calendar 와 동일 설정) ----------------
# deploy-hosts.env.example 의 KEYCLOAK_ALLOWED_HOSTS 와 동일하게 맞추세요.
# KEYCLOAK_ENABLED=true
# KEYCLOAK_URL=http://localhost:3000
# KEYCLOAK_SERVER_URL=http://127.0.0.1:3000
# KEYCLOAK_REALM=work
# KEYCLOAK_CLIENT_ID=whiteboard4share
# KEYCLOAK_CLIENT_SECRET=<Keycloak Client Credentials>
# APP_BASE_URL=http://localhost:3007
# KEYCLOAK_DYNAMIC_ORIGIN=true
# KEYCLOAK_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.162,xwind.iptime.org
# KEYCLOAK_ROLE_SUPER=super-admin
# KEYCLOAK_ROLE_DEPT=dept-admin
# KEYCLOAK_ALLOW_LOCAL=false

# SSO 사용 시 좌측 상단 [홈] → MyPortal 메인 (KEYCLOAK_ENABLED=true 일 때만)
# MYPORTAL_PORT=3001
# HOME_URL=http://localhost:3001
# HOME_TARGET=self

# HTTPS 리버스 프록시 뒤에서만 1 로 설정 (HTTP 내부망은 0 또는 미설정)
# COOKIE_SECURE=0
