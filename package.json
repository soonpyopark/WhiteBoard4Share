{
  "name": "whiteboard4share",
  "private": true,
  "version": "1.0.6",
  "description": "Whiteboard4Share",
  "author": "청년안민규",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"node scripts/dev-electron.mjs\"",
    "dev:web": "vite",
    "dev:restart": "node scripts/dev-restart.mjs",
    "prepare:icon": "node scripts/prepare-icon.mjs",
    "build": "npm run prepare:icon && tsc -b && vite build",
    "lint": "oxlint",
    "start": "node scripts/start-electron.mjs",
    "start:web": "tsx server/index.ts",
    "restart": "node scripts/restart.mjs",
    "preview": "npm run build && npm run start",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "build:dist:exe": "node scripts/build-dist-exe.mjs",
    "build:msi": "node scripts/build-msi.mjs",
    "build:release": "node scripts/build-release.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "update_all.bat _inner build",
    "postinstall": "node scripts/postinstall-electron.mjs"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.19.0",
    "xlsx-js-style": "^1.2.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.69.0",
    "png2icons": "^2.0.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.whiteboard4share.app",
    "productName": "Whiteboard4Share",
    "directories": {
      "buildResources": "electron"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "asar": true,
    "icon": "icon.png",
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "icon.ico",
      "signExecutable": false
    }
  },
  "allowScripts": {
    "electron@44.1.1": true
  }
}
